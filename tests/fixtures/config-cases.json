[
  { "name": "empty config gives restrictive defaults", "input": {}, "warn": false,
    "expect": { "profile": "opt-in", "policyVersion": "1", "google.enabled": false, "google.mode": "basic", "cookie.name": "open_consent", "cookie.days": 180, "ui.layout": "bar" } },
  { "name": "numeric policy version is stringified", "input": { "policyVersion": 3 }, "warn": false, "expect": { "policyVersion": "3" } },
  { "name": "bad policy version rejected", "input": { "policyVersion": "1 2" }, "warn": true, "expect": { "policyVersion": "1" } },
  { "name": "unknown profile rejected", "input": { "profile": "assume-yes" }, "warn": true, "expect": { "profile": "opt-in" } },
  { "name": "opt-out accepted", "input": { "profile": "opt-out" }, "warn": false, "expect": { "profile": "opt-out" } },
  { "name": "unknown top-level key dropped", "input": { "onAccept": "alert(1)" }, "warn": true, "expect": { "onAccept": null } },
  { "name": "javascript: URL rejected", "input": { "links": { "privacyPolicy": "javascript:alert(1)" } }, "warn": true, "expect": { "links.privacyPolicy": "" } },
  { "name": "protocol-relative URL rejected", "input": { "links": { "cookiePolicy": "//evil.example/x" } }, "warn": true, "expect": { "links.cookiePolicy": "" } },
  { "name": "https and root-relative URLs accepted", "input": { "links": { "privacyPolicy": "https://example.com/privacy", "cookiePolicy": "/cookies/" } }, "warn": false,
    "expect": { "links.privacyPolicy": "https://example.com/privacy", "links.cookiePolicy": "/cookies/" } },
  { "name": "CSS injection in colour rejected", "input": { "ui": { "theme": { "accent": "red;}body{display:none" } } }, "warn": true, "expect": { "ui.theme.accent": "#1a56db" } },
  { "name": "valid colours accepted", "input": { "ui": { "theme": { "accent": "#0a0", "background": "rgb(10, 20, 30)" } } }, "warn": false,
    "expect": { "ui.theme.accent": "#0a0", "ui.theme.background": "rgb(10, 20, 30)" } },
  { "name": "optional category cannot be made required", "input": { "categories": { "marketing": { "required": true } } }, "warn": true, "expect": { "categories.marketing.required": false } },
  { "name": "necessary cannot be removed", "input": { "categories": { "necessary": false } }, "warn": true, "expect": { "categories.necessary.required": true } },
  { "name": "functional can be removed", "input": { "categories": { "functional": false } }, "warn": false, "expect": { "categories.functional": null } },
  { "name": "custom category added", "input": { "categories": { "social": { "cookies": ["fr", "_pin_*"] } } }, "warn": false,
    "expect": { "categories.social.required": false, "categories.social.cookies": ["fr", "_pin_*"] } },
  { "name": "invalid category name rejected", "input": { "categories": { "Bad Name": {} } }, "warn": true, "expect": { "categories.Bad Name": null } },
  { "name": "cookie days out of range", "input": { "cookie": { "days": 5000 } }, "warn": true, "expect": { "cookie.days": 180 } },
  { "name": "SameSite None forces Secure", "input": { "cookie": { "sameSite": "None" } }, "warn": false, "expect": { "cookie.sameSite": "None", "cookie.secure": true } },
  { "name": "google tag category inferred", "input": { "google": { "enabled": true, "tags": ["G-ABC12345", { "id": "AW-1234567" }] } }, "warn": false,
    "expect": { "google.tags": [{ "id": "G-ABC12345", "category": "analytics" }, { "id": "AW-1234567", "category": "marketing" }] } },
  { "name": "GT tag needs explicit category", "input": { "google": { "tags": ["GT-ABCDE12"] } }, "warn": true, "expect": { "google.tags": [] } },
  { "name": "google tag cannot be necessary", "input": { "google": { "tags": [{ "id": "G-ABC12345", "category": "necessary" }] } }, "warn": true, "expect": { "google.tags": [] } },
  { "name": "invalid google tag id", "input": { "google": { "tags": ["G-<script>"] } }, "warn": true, "expect": { "google.tags": [] } },
  { "name": "google region list", "input": { "google": { "region": ["DE", "US-CA"] } }, "warn": false, "expect": { "google.region": ["DE", "US-CA"] } },
  { "name": "bad google region rejects list", "input": { "google": { "region": ["de"] } }, "warn": true, "expect": { "google.region": [] } },
  { "name": "texts override kept", "input": { "texts": { "en": { "banner": { "title": "Cookies" } } } }, "warn": false, "expect": { "texts.en.banner.title": "Cookies" } },
  { "name": "non-string text dropped", "input": { "texts": { "en": { "banner": { "title": 5 } } } }, "warn": true, "expect": { "texts.en.banner.title": null } },
  { "name": "non-object config", "input": "nope", "warn": true, "expect": { "profile": "opt-in" } }
]
